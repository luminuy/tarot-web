{
  "name": "tarot-web",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "log:sync": "tsx scripts/sync-worklog.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "verify:cards": "tsx scripts/verify-cards.ts",
    "cards:variants": "tsx scripts/generate-card-variants.ts",
    "agent:status": "tsx scripts/agent-guard.ts status",
    "agent:check": "tsx scripts/agent-guard.ts check",
    "agent:lock": "tsx scripts/agent-guard.ts lock",
    "agent:unlock": "tsx scripts/agent-guard.ts unlock",
    "repo:verify": "tsx scripts/github-auto.ts verify-all",
    "pr:auto": "tsx scripts/github-auto.ts pr",
    "git:tidy": "tsx scripts/github-auto.ts tidy",
    "commit": "tsx scripts/git-author-guard.ts",
    "incident": "tsx scripts/incident-log.ts",
    "hooks:setup": "git config core.hooksPath .githooks",
    "audit:show": "tsx scripts/audit-tracker.ts show",
    "audit:track": "tsx scripts/audit-tracker.ts track"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@prisma/client": "^7.10.0",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
