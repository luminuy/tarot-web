# Merge strategy: union for append-only log files
# Prevents merge conflicts when multiple agents/branches append to the same log
docs/WORK_LOG.md merge=union
docs/INCIDENT_LOG.md merge=union
docs/AUDIT_LOG.md merge=union

# Line endings
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
