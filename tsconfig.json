{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    // ด่านกันโค้ดตายกลับมาสะสมอีก — ตัวแปร/พารามิเตอร์/import ที่ไม่มีใครใช้จะทำให้
    // `npm run typecheck` (และ CI ทั้ง 24 ด่าน) ไม่ผ่านทันที
    // เปิดได้หลังเก็บกวาดของค้าง 43 จุดจนหมดแล้ว ห้ามปิดกลับเพื่อให้ commit ผ่าน
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "open-next.config.ts"
  ]
}
