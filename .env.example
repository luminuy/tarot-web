# ===== Google OAuth 2.0 (ใช้เพื่อเข้าสู่ระบบ) =====
# ได้มาจาก Google Cloud Console: https://console.cloud.google.com/
# 1. สร้าง OAuth 2.0 Client ID (Web application)
# 2. ตั้งค่า Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ===== Google Gemini API (AI Model หลัก) =====
GEMINI_API_KEY=AIzaSy...
# หรือใช้ GOOGLE_API_KEY=AIzaSy...

# ===== Anthropic Claude API (ทางเลือกเสริม) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Cloudflare AI Gateway (ไม่บังคับ — route ทุก AI ผ่าน gateway เดียว) =====
# สร้าง gateway ที่ dashboard → AI → AI Gateway แล้วเอา account id + ชื่อ gateway มาใส่
# ไม่ตั้ง = ยิงตรงไป provider เหมือนเดิม (ไม่พัง) · Production: npx wrangler secret put CF_AI_GATEWAY_ACCOUNT_ID
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
# ใส่เฉพาะเมื่อเปิด "Authenticated Gateway" ใน dashboard
CF_AI_GATEWAY_TOKEN=

# ===== Upstash Redis (ไม่บังคับ — ย้ายตัวนับ/เซสชันเปิดไพ่ออกจาก Cloudflare KV) =====
# ทำไม: KV แพ็กเกจฟรีเขียนได้ ~1,000 ครั้ง/วัน ซึ่งเป็นคอขวดจริงของเว็บ (ข้อ 16 ในคู่มือ)
#       Upstash ฟรี 10,000 คำสั่ง/วัน และมี INCRBY แบบ atomic ทำให้โควตาแม่นข้าม edge ด้วย
# ไม่ตั้ง = ระบบใช้ Cloudflare KV เหมือนเดิมทุกอย่าง (ไม่พัง)
# สมัคร: https://upstash.com → Create Database (เลือก Region ใกล้สุด) → แท็บ REST API
# Production: npx wrangler secret put UPSTASH_REDIS_REST_URL
#             npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
# ตรวจสถานะได้ที่ /admin → Cloud Health → cloudflareStack.upstashRedis.reachable
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Cloudflare Turnstile (ไม่บังคับ — กันบอทหน้า signup/login/forgot) =====
# Dashboard → Turnstile → Add widget → เอา Site Key + Secret มาใส่
# ต้องมีคู่กันทั้งสองตัวด่านถึงจะทำงาน · ไม่ตั้ง = ด่านผ่านตลอด (ระบบเดิมไม่กระทบ)
# site key ไม่ใช่ความลับ แต่ตั้งผ่าน secret เพราะ pipeline deploy ไม่ส่ง env ตอน build
# client ดึงผ่าน /api/config/turnstile ตอน runtime
# Production: npx wrangler secret put TURNSTILE_SITE_KEY
TURNSTILE_SITE_KEY=
# Production: npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# ===== Provably-Fair & Session Security (จำเป็นสำหรับ Production) =====
# ใช้เซ็น Stateless Session Token HMAC-SHA256 ป้องกันการปลอมแปลงไพ่ข้าม Edge Node
TAROT_SESSION_SECRET=your-random-32-byte-hex-secret-here   # สร้างด้วย: openssl rand -hex 32
AUTH_SECRET=your-auth-secret-for-session-signing

# ===== แผงแอดมิน & รหัสทดสอบ (Admin Panel & Bypass Token) =====
# รหัสผ่านเข้าแผงแอดมิน /admin — แยกจาก OAuth ผู้ใช้ทั่วไป (ต้อง ≥ 12 ตัวอักษร)
# Production: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=change-me-to-a-long-random-password
# รหัสผ่านข้าม Rate Limit สำหรับการทดสอบ (ความยาว ≥ 24 ตัวอักษร)
# Production: npx wrangler secret put RATE_LIMIT_BYPASS_TOKEN
RATE_LIMIT_BYPASS_TOKEN=your-random-32-byte-bypass-token-here

# ===== AI Daily Call Budget (เพดานเรียก AI ต่อวัน) =====
AI_DAILY_CALL_CAP=2000

# ===== 📊 การวัดผลเว็บไซต์ (Google Analytics 4 & Meta Pixel) =====
# ⚠️ หมายเหตุสำคัญสำหรับตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_*:
#    ตัวแปรเหล่านี้จะถูก Next.js ฝัง (inline) ลงใน Client Bundle ตั้งแต่ตอน build
#    การตั้งค่าบน Cloudflare Workers Secret ตอน runtime ด้วย `wrangler secret put` จะไม่มีผลใดๆ
#    Production: ให้ตั้งค่าที่ GitHub Repository -> Settings -> Secrets and variables -> Actions
#    (เลือกแท็บ Variables หรือ Secrets โดย deploy.yml จะส่งค่าเข้าไปตอน build ให้อัตโนมัติ)

# 1. Google Analytics 4 (GA4):
#    - รูปแบบ: G-XXXXXXXXXX (ขึ้นต้นด้วย G- ตามด้วยตัวเลข/ตัวอักษรภาษาอังกฤษ)
#    - วิธีรับ ID: เข้า Google Analytics (https://analytics.google.com/)
#      -> Admin (ผู้ดูแลระบบ) -> Data Streams (สตรีมข้อมูล) -> เลือก Web Stream -> คัดลอก "Measurement ID"
#    - Development: ใส่ใน .env หรือ .env.local
#    - Production: GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_GA_ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 2. Meta Pixel (Facebook & Instagram):
#    - รูปแบบ: ตัวเลขล้วน 12-17 หลัก (เช่น 1234567890123456)
#    - วิธีรับ ID: เข้า Meta Events Manager (https://business.facebook.com/events_manager)
#      -> Data Sources -> คัดลอก Pixel ID
#    - Production: GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_META_PIXEL_ID
NEXT_PUBLIC_META_PIXEL_ID=

# 3. Google Ads (การวัด Conversion & รีมาร์เก็ตติ้ง):
#    - รูปแบบ: AW-XXXXXXXXX (ขึ้นต้นด้วย AW- ตามด้วยตัวเลข 7-15 หลัก)
#    - วิธีรับ ID: เข้า Google Ads (https://ads.google.com/)
#      -> Goals (เป้าหมาย) -> Conversions (การกระทำที่ถือเป็น Conversion) -> Google tag -> คัดลอก Tag ID (AW-...)
#    - Conversion Label (ทางเลือก): รหัสป้ายกำกับการแปลงสภาพ เช่น AbCdEfGhIjK
#    - Production: GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_GOOGLE_ADS_ID (และ NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# ===== 🖼️ ขุมพลังสื่อคู่ขนาน (Dual-Engine Media Pipeline: ImageKit + Cloudinary) =====
# 1. ImageKit.io (เสิร์ฟภาพไพ่ 78 ใบ & WebP ผ่าน CDN ตัดภาระ Egress ของ Worker)
#    - สมัครฟรี: https://imagekit.io/registration (ฟรี 25 GB/เดือน)
#    - ตั้งค่า Web Origin ชี้ไปที่ https://seertarot.net
#    - รูปแบบ: https://ik.imagekit.io/<your_id>
#    - Production: GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# 2. Cloudinary (เจนภาพแชร์ดวง OpenGraph 1200x630 ไดนามิก 0ms CPU บน Worker)
#    - สมัครฟรี: https://cloudinary.com/users/register_free (ฟรี 25 Credits/เดือน)
#    - คัดลอก Cloud Name จาก Dashboard มาใส่
#    - Production: GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


