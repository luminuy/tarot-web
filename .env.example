# ===== Google OAuth 2.0 (ใช้เพื่อเข้าสู่ระบบ) =====
# ได้มาจาก Google Cloud Console: https://console.cloud.google.com/
# 1. สร้าง OAuth 2.0 Client ID (Web application)
# 2. ตั้งค่า Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ===== Google Gemini API (AI Model หลัก) =====
GEMINI_API_KEY=AIzaSy...
# หรือใช้ GOOGLE_API_KEY=AIzaSy...

# ===== Anthropic Claude API (ทางเลือกเสริม) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Provably-Fair & Session Security (จำเป็นสำหรับ Production) =====
# ใช้เซ็น Stateless Session Token HMAC-SHA256 ป้องกันการปลอมแปลงไพ่ข้าม Edge Node
TAROT_SESSION_SECRET=your-random-32-byte-hex-secret-here   # สร้างด้วย: openssl rand -hex 32
AUTH_SECRET=your-auth-secret-for-session-signing

# ===== Cloudflare Turnstile Bot Protection (ทางเลือก) =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

