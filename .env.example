# ===== Google OAuth 2.0 (ใช้เพื่อเข้าสู่ระบบ) =====
# ได้มาจาก Google Cloud Console: https://console.cloud.google.com/
# 1. สร้าง OAuth 2.0 Client ID (Web application)
# 2. ตั้งค่า Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ===== Google Gemini API (AI Model หลัก) =====
GEMINI_API_KEY=AIzaSy...
# หรือใช้ GOOGLE_API_KEY=AIzaSy...

# ===== Anthropic Claude API (ทางเลือกเสริม) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Cloudflare AI Gateway (ไม่บังคับ — route ทุก AI ผ่าน gateway เดียว) =====
# สร้าง gateway ที่ dashboard → AI → AI Gateway แล้วเอา account id + ชื่อ gateway มาใส่
# ไม่ตั้ง = ยิงตรงไป provider เหมือนเดิม (ไม่พัง) · Production: npx wrangler secret put CF_AI_GATEWAY_ACCOUNT_ID
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
# ใส่เฉพาะเมื่อเปิด "Authenticated Gateway" ใน dashboard
CF_AI_GATEWAY_TOKEN=

# ===== Cloudflare Turnstile (ไม่บังคับ — กันบอทหน้า signup/login/forgot) =====
# Dashboard → Turnstile → Add widget → เอา Site Key + Secret มาใส่
# ต้องมีคู่กันทั้งสองตัวด่านถึงจะทำงาน · ไม่ตั้ง = ด่านผ่านตลอด (ระบบเดิมไม่กระทบ)
# site key ไม่ใช่ความลับ แต่ตั้งผ่าน secret เพราะ pipeline deploy ไม่ส่ง env ตอน build
# client ดึงผ่าน /api/config/turnstile ตอน runtime
# Production: npx wrangler secret put TURNSTILE_SITE_KEY
TURNSTILE_SITE_KEY=
# Production: npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# ===== Provably-Fair & Session Security (จำเป็นสำหรับ Production) =====
# ใช้เซ็น Stateless Session Token HMAC-SHA256 ป้องกันการปลอมแปลงไพ่ข้าม Edge Node
TAROT_SESSION_SECRET=your-random-32-byte-hex-secret-here   # สร้างด้วย: openssl rand -hex 32
AUTH_SECRET=your-auth-secret-for-session-signing

# ===== แผงแอดมิน & รหัสทดสอบ (Admin Panel & Bypass Token) =====
# รหัสผ่านเข้าแผงแอดมิน /admin — แยกจาก OAuth ผู้ใช้ทั่วไป (ต้อง ≥ 12 ตัวอักษร)
# Production: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=change-me-to-a-long-random-password
# รหัสผ่านข้าม Rate Limit สำหรับการทดสอบ (ความยาว ≥ 24 ตัวอักษร)
# Production: npx wrangler secret put RATE_LIMIT_BYPASS_TOKEN
RATE_LIMIT_BYPASS_TOKEN=your-random-32-byte-bypass-token-here

# ===== AI Daily Call Budget (เพดานเรียก AI ต่อวัน) =====
AI_DAILY_CALL_CAP=2000

# ===== 📊 การวัดผลเว็บไซต์ (Google Analytics 4 & Meta Pixel) =====
# 1. Google Analytics 4 (GA4):
#    - รูปแบบ: G-XXXXXXXXXX (ขึ้นต้นด้วย G- ตามด้วยตัวเลข/ตัวอักษรภาษาอังกฤษ)
#    - วิธีรับ ID: เข้า Google Analytics (https://analytics.google.com/)
#      -> Admin (ผู้ดูแลระบบ) -> Data Streams (สตรีมข้อมูล) -> เลือก Web Stream -> คัดลอก "Measurement ID"
#    - Development: ใส่ใน .env หรือ .env.local
#    - Production (Cloudflare / GitHub):
#      - GitHub Actions Secret หรือ Variable: NEXT_PUBLIC_GA_ID
#      - หรือตั้งค่าบน Cloudflare Workers Secret ตอน runtime:
#        npx wrangler secret put GA_MEASUREMENT_ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 2. Meta Pixel (Facebook & Instagram):
#    - รูปแบบ: ตัวเลขล้วน 12-17 หลัก (เช่น 1234567890123456)
#    - วิธีรับ ID: เข้า Meta Events Manager (https://business.facebook.com/events_manager)
#      -> Data Sources -> คัดลอก Pixel ID
#    - Production: npx wrangler secret put META_PIXEL_ID
NEXT_PUBLIC_META_PIXEL_ID=
