# ===== Google Gemini API (หลัก) =====
GEMINI_API_KEY=AIzaSy...
# หรือใช้ GOOGLE_API_KEY=AIzaSy...

# ===== Claude API (ทางเลือกเสริม) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Database =====
DATABASE_URL="postgresql://user:pass@localhost:5432/tarot"

# ===== Auth (NextAuth v5) =====
AUTH_SECRET=            # สร้างด้วย: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# ===== ความลับสำหรับพิสูจน์ความสุ่ม (commit-reveal) =====
# ใช้เซ็น seed ก่อนเปิดไพ่ เพื่อพิสูจน์ว่าไม่ได้เลือกไพ่ทีหลัง
SHUFFLE_HMAC_SECRET=     # สร้างด้วย: openssl rand -hex 32
