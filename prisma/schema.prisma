// ฐานข้อมูลของเว็บดูดวงไพ่
// หมายเหตุเรื่อง PDPA: ตาราง Reading เก็บคำถามที่ผู้ใช้พิมพ์ ซึ่งเป็นข้อมูลอ่อนไหวมาก
// (ความรัก การเงิน ความสัมพันธ์) จึงต้องมีเส้นทางลบข้อมูลของผู้ใช้จริง ๆ ไม่ใช่แค่ซ่อน
// onDelete: Cascade ทุกความสัมพันธ์ที่ผูกกับ User คือส่วนหนึ่งของเรื่องนี้
//
// ยังไม่ได้เชื่อมต่อใช้งานจริง — แอปตอนนี้ใช้ src/server/store.ts (in-memory) แทน
// ก่อนจะต่อ Prisma จริง ต้องแก้ให้เข้ากับ Prisma 7:
// `datasource.url` ถูกถอดออกจาก schema แล้ว ต้องย้ายไปตั้งใน prisma.config.ts
// พร้อมเลือก adapter (เช่น @prisma/adapter-pg สำหรับ Postgres) —ดู https://pris.ly/d/config-datasource
// จนกว่าจะถึงตอนนั้น `pnpm build` จะไม่รัน `prisma generate` ให้ (ใช้ `pnpm db:generate` เองตอนพร้อมต่อจริง)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ผู้ใช้และบัญชี =====

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  nickname      String?   // ชื่อที่อยากให้แม่หมอเรียก
  image         String?
  emailVerified DateTime?

  /// บุคลิกแม่หมอที่ใช้เป็นค่าเริ่มต้น
  preferredPersona String @default("warm")

  /// ยอดเครดิตคงเหลือ — คำนวณจาก CreditLedger เสมอ ห้ามแก้ตรงนี้มือเปล่า
  creditBalance Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  readings      Reading[]
  ledger        CreditLedger[]
  subscription  Subscription?
  journal       JournalEntry[]
  dailyCards    DailyCard[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== การเปิดไพ่ =====

enum ReadingStatus {
  DRAWING   // สร้าง commitment แล้ว รอผู้ใช้สับและเลือกไพ่
  READING   // กำลังให้ AI อ่าน
  COMPLETED
  FAILED
}

model Reading {
  id     String        @id @default(cuid())
  userId String?
  status ReadingStatus @default(DRAWING)

  spreadId String
  category String
  personaId String @default("warm")

  /// คำถามที่ผู้ใช้พิมพ์ — ข้อมูลอ่อนไหว
  question String  @db.Text
  /// คำตอบจากขั้นตอนซักถามก่อนเปิดไพ่ (situation / feeling / hoped)
  intake   Json?

  // --- หลักฐานความสุ่มที่ตรวจสอบได้ ---
  /// แฮชของ serverSeed ที่โชว์ให้ผู้ใช้ "ก่อน" สับไพ่
  commitment String
  /// serverSeed จริง เปิดเผยหลังอ่านเสร็จ เพื่อให้ผู้ใช้ตรวจย้อนหลังได้
  serverSeed String?
  /// seed ที่มาจากการสับของผู้ใช้เอง
  clientSeed String?
  /// ไพ่ที่จั่วได้ [{order, cardIndex, isReversed}]
  drawnCards Json?

  /// ผลการตรวจความปลอดภัยของคำถาม
  safetyFlag String @default("none")

  /// คำอ่านฉบับเต็มตาม ReadingSchema
  result Json?

  /// สถิติต้นทุนต่อการอ่านหนึ่งครั้ง — ต้องเก็บตั้งแต่วันแรก ไม่งั้นบิลบานปลายแบบไม่รู้ตัว
  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)

  /// คะแนน "แม่นไหม" ที่ผู้ใช้ให้ 1-5 — ข้อมูลที่ใช้ปรับ prompt ให้ดีขึ้นเรื่อย ๆ
  accuracyRating Int?

  /// โทเคนสำหรับลิงก์แชร์สาธารณะ null = ยังไม่ได้แชร์
  shareToken String? @unique

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  journal  JournalEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// การถามต่อยอดหลังเปิดไพ่ — แม่หมอจริงต้องถามกลับได้
model ChatMessage {
  id        String   @id @default(cuid())
  readingId String
  role      String // "user" | "assistant"
  content   String   @db.Text
  /// ตำแหน่งไพ่ที่คำตอบนี้อ้างถึง ใช้ไฮไลต์บนหน้าเว็บ
  referencedPositions Json?
  createdAt DateTime @default(now())

  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId, createdAt])
}

/// ไพ่ประจำวัน — ตัวดึงคนกลับมาทุกวัน จำกัดวันละใบต่อคน
model DailyCard {
  id        String   @id @default(cuid())
  userId    String
  /// วันที่ตามเวลาไทย รูปแบบ YYYY-MM-DD เพื่อบังคับหนึ่งใบต่อวันได้จริง
  drawDate  String
  cardIndex Int
  isReversed Boolean
  note      String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, drawDate])
  @@index([userId, drawDate])
}

/// สมุดบันทึกดวง — ผู้ใช้กลับมาจดว่าเกิดขึ้นจริงไหม
/// เป็นฟีเจอร์ที่ทำให้คนยอมจ่ายรายเดือน เพราะคุณค่าสะสมตามเวลา
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  readingId String?
  /// สิ่งที่เกิดขึ้นจริงหลังจากเปิดไพ่
  outcome   String   @db.Text
  /// ตรงแค่ไหน 1-5
  accuracy  Int?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading Reading? @relation(fields: [readingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ===== เครดิตและสมาชิก =====

enum LedgerReason {
  SIGNUP_BONUS
  PURCHASE
  SUBSCRIPTION_GRANT
  REFERRAL
  READING_SPEND
  REFUND
  ADMIN_ADJUST
}

/// บัญชีเดินสะพัดของเครดิต — ยอดคงเหลือคือผลรวมของตารางนี้เสมอ
/// เก็บเป็น ledger ไม่ใช่ตัวเลขเดียว เพราะเมื่อมีข้อพิพาทเรื่องเงินต้องย้อนดูได้ว่าเกิดอะไรขึ้น
model CreditLedger {
  id       String       @id @default(cuid())
  userId   String
  /// บวกคือได้รับ ลบคือใช้ไป
  amount   Int
  reason   LedgerReason
  /// อ้างอิงถึง readingId หรือ paymentId แล้วแต่ประเภท
  refId    String?
  note     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// กันหักเครดิตซ้ำจากการกดปุ่มรัว หรือ request ที่ retry
  @@unique([userId, reason, refId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id     String             @id @default(cuid())
  userId String             @unique
  status SubscriptionStatus @default(ACTIVE)
  /// รหัสแพ็กเกจ เช่น "monthly" | "yearly"
  plan   String
  /// เครดิตที่เติมให้อัตโนมัติทุกรอบบิล
  creditsPerCycle Int @default(30)

  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean @default(false)

  /// รหัสอ้างอิงจากผู้ให้บริการชำระเงิน
  providerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}
