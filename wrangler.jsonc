{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarot-db",
      "database_id": "tarot-db-production"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TAROT_STORAGE",
      "bucket_name": "tarot-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TAROT_KV",
      "id": "tarot_kv_cache"
    }
  ]
}
