{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Static assets (ภาพไพ่ 1909 · _next/static · หน้าเนื้อหาที่เรนเดอร์ด้วย Astro) ──
  //
  // 🚦 ลำดับที่ Cloudflare ใช้ตัดสิน: **ไฟล์ static มาก่อน Worker เสมอ**
  //    คำขอที่ตรงกับไฟล์ในโฟลเดอร์นี้จะถูกตอบที่ขอบโดย **ไม่ปลุก Worker เลย**
  //    (ไม่เสียค่าคำขอ · ไม่ต้องบูต runtime ของ Next) ส่วนคำขอที่ไม่ตรงไฟล์ไหนเลย
  //    จึงค่อยตกไปที่ Worker ตามปกติ — นี่คือกลไกที่ทำให้หน้าเนื้อหา 174 หน้า
  //    ที่ `scripts/merge-astro-assets.ts` คัดลอกมาไว้ตรงนี้ เสิร์ฟจากขอบได้ทันที
  //
  // ⚠️ สามค่าล่างเขียนไว้ตรง ๆ ทั้งที่ตรงกับค่าเริ่มต้นอยู่แล้ว — โดยตั้งใจ
  //    พฤติกรรมของทั้งเว็บครึ่งหนึ่งไม่ควรขึ้นกับ "ค่าเริ่มต้นที่ผู้ให้บริการอาจเปลี่ยนวันหนึ่ง"
  //
  //    html_handling: "auto-trailing-slash"
  //        `/cards/major-00` ➔ เสิร์ฟไฟล์ `cards/major-00.html`
  //        ถ้าเป็น "none" หน้าเนื้อหาทั้งหมดจะ 404 ทันที (ต้องพิมพ์ .html เอง)
  //    not_found_handling: "none"
  //        ไม่ตรงไฟล์ไหน ➔ ส่งต่อให้ Worker (หน้าแอป · /api/* · sitemap ยังทำงานเหมือนเดิม)
  //        ห้ามใช้ "404-page" เด็ดขาด — Worker จะไม่ได้รับคำขอที่ไม่ใช่ไฟล์อีกเลยทั้งเว็บ
  //    run_worker_first: false
  //        ถ้าเป็น true ทุกคำขอจะวิ่งเข้า Worker ก่อน = จ่ายค่าคำขอเท่าเดิมกับก่อนย้าย
  //        และหน้าเนื้อหาจะ 404 เพราะ Next ไม่มีเส้นทางเหล่านั้นอีกแล้ว
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  },

  // ── OpenNext Edge Caching ────────────────────────────────────────────────────
  // หน้า SSG ทั้งหมดถูก seed ลง KV ตอน `opennextjs-cloudflare deploy` (populateCache)
  // แล้ว cache interception เสิร์ฟจาก KV ที่ edge โดยไม่ boot Next runtime
  // ⚠️ id ต้องเป็นของจริงจาก `npx wrangler kv namespace list`
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "3b06e256c46948949fc17ac6641cafa3"
    }
  ],

  // ── Cloudflare D1 Database (Marketplace & Readers) ───────────────────────────
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "tarot-app-db",
      "database_id": "560fdbe7-e1f5-46e1-bad6-c8c387dcfcb5"
    }
  ],

  // ── Workers AI (ฟรี ~10k neurons/วัน) ────────────────────────────────────────
  // ใช้กับตัวจำแนกความปลอดภัยชั้น 3 (src/lib/safety/ai-classifier.ts) — จับสัญญาณ
  // ทำร้ายตัวเองแบบอ้อมที่ regex ไม่จับ · fail-open ถ้าไม่พร้อม จึงไม่ต้อง provision อะไรก่อน
  // schema: RawConfig.ai = { binding: string } (ตรวจกับ config-schema.json แล้ว — INC-0034)
  "ai": {
    "binding": "AI"
  },

  // ── Vectorize (ฟรี 30M dim-query/เดือน) ──────────────────────────────────────
  // ค้นหาเชิงความหมาย — "ไพ่/บทความที่พลังงานใกล้เคียง" (src/lib/search/vectorize.ts)
  // index สร้างไว้แล้ว: card-meanings · 1024 มิติ · cosine (ตรงกับ @cf/baai/bge-m3)
  // schema: RawConfig.vectorize = [{ binding, index_name }] (ตรวจ config-schema.json — INC-0034)
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "card-meanings"
    }
  ],

  // ── R2 (ฟรี 10GB · ไม่มีค่า egress) ──────────────────────────────────────────
  // เก็บภาพการ์ดแชร์ที่ผู้ใช้สร้างเอง (client canvas) → OG image ให้ลิงก์แชร์
  // bucket `seertarot-share` · ควรตั้ง lifecycle ลบอัตโนมัติ ~90 วัน (PDPA)
  // schema: RawConfig.r2_buckets = [{ binding, bucket_name }] (ตรวจ config-schema.json — INC-0034)
  // ⚠️ wrangler validate bucket ผ่าน R2 API ตอน deploy → `CLOUDFLARE_API_TOKEN` ใน CI
  //    ต้องมี permission "Account · Workers R2 Storage · Edit" (เติมแล้ว 2026-09-03 · ดู INC hotfix #202)
  "r2_buckets": [
    {
      "binding": "SHARE_BUCKET",
      "bucket_name": "seertarot-share"
    }
  ],

  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/seertarotweb",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "xtgpasdc"
  }

  // ── Secrets สำหรับ OAuth & Session Security ───────────────────────────────────
  // ⚠️ ห้ามประกาศ secrets ใน wrangler.jsonc — ไม่มีฟิลด์ "secrets" ใน schema
  // (การใส่ทำให้ `opennextjs-cloudflare build` ล้มทันที: config validation failed)
  // secrets ที่ตั้งผ่าน `wrangler secret put` จะพร้อมใช้เป็น env binding ตอน runtime เอง
  // ตั้งค่าครั้งเดียวด้วย (ต้องมี CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID):
  //   npx wrangler secret put GOOGLE_CLIENT_ID
  //   npx wrangler secret put GOOGLE_CLIENT_SECRET
  //   npx wrangler secret put TAROT_SESSION_SECRET
  //   npx wrangler secret put LINE_CHANNEL_ID
  //   npx wrangler secret put LINE_CHANNEL_SECRET
  // ตรวจรายชื่อที่ตั้งไว้แล้ว: npx wrangler secret list
}
