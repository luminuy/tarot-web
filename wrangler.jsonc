{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Static assets (ภาพไพ่ 1909, _next/static ฯลฯ) ─────────────────────────────
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ── OpenNext Edge Caching ────────────────────────────────────────────────────
  // หน้า SSG ทั้งหมดถูก seed ลง KV ตอน `opennextjs-cloudflare deploy` (populateCache)
  // แล้ว cache interception เสิร์ฟจาก KV ที่ edge โดยไม่ boot Next runtime
  // ⚠️ id ต้องเป็นของจริงจาก `npx wrangler kv namespace list`
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "3b06e256c46948949fc17ac6641cafa3"
    }
  ],

  "vars": {
    "NODE_ENV": "production"
  },

  // ── Secrets สำหรับ OAuth & Session Security ───────────────────────────────────
  // ⚠️ IMPORTANT: ใช้ `npm run secret:sync` เพื่อเก็บ secrets ไว้ใน Cloudflare Workers
  // ไม่ต้องใส่ค่า concrete ที่นี่ — Wrangler จะอ่านจากจริงตอน deploy
  // เพิ่มชื่อ secrets ทั้งหมด:
  // - GOOGLE_CLIENT_ID
  // - GOOGLE_CLIENT_SECRET
  // - TAROT_SESSION_SECRET
  // - AUTH_SECRET (ถ้าใช้)
  "secrets": [
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "TAROT_SESSION_SECRET"
  ]
}
