---
import { blogCardItems, buildBlogIndexMetadata } from "@/app/_shared/pages/blog-index";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { BlogIndexBodyRoot } from "../../components/PageBodies";
import { BlogIndexRoot } from "../../islands/BlogIslands";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";
import "@/styles/ui2-showcase.css";
import "@/styles/v2-blog.css";

/** 📚 คัมภีร์บทความ — หน้ารวม (ต้นไม้ภาษาไทย) */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={buildBlogIndexMetadata(locale)}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <BlogIndexBodyRoot locale={locale}>
    <Fragment slot="list">
      <BlogIndexRoot locale={locale} articles={blogCardItems(locale)} client:idle />
    </Fragment>
  </BlogIndexBodyRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../scripts/ui2-inview";
  import "../../scripts/ui2-showcase";
</script>
