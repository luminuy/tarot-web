---
import { contactMetadataTh } from "@/app/_shared/pages/contact-th";

import BaseLayout from "../layouts/BaseLayout.astro";
import { ContactBodyThRoot } from "../components/PageBodies";
import { SiteFooterRoot, SiteHeaderRoot } from "../islands/SiteShell";

/** ✉️ ช่องทางติดต่อ — หน้าข้อความล้วน ไม่มีส่วนไหนต้องใช้ JS เลย */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={contactMetadataTh}>
  <SiteHeaderRoot locale={locale} client:idle />
  <ContactBodyThRoot />
  <SiteFooterRoot locale={locale} spacing="tight" />
</BaseLayout>
