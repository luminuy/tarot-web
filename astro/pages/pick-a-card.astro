---
import { pickACardMetadataTh } from "@/app/_shared/pages/pick-a-card-th";

import BaseLayout from "../layouts/BaseLayout.astro";
import { PickACardBodyThRoot } from "../components/PageBodies";
import { PickACardIsland } from "../islands/PickACardIsland";
import { SiteFooterRoot, SiteHeaderRoot } from "../islands/SiteShell";
import "@/styles/ui2-page.css";

/** 🔮 Pick A Card — พิธีเลือกกองไพ่เป็น island · เนื้อหา SEO ท้ายหน้าเป็น HTML ล้วน */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={pickACardMetadataTh}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <PickACardBodyThRoot>
    <Fragment slot="ritual">
      <PickACardIsland locale={locale} client:load />
    </Fragment>
  </PickACardBodyThRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>
