---
import { buildSpreadsIndexMetadata } from "@/app/_shared/pages/spreads-index";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SpreadsIndexBodyRoot } from "../../../components/PageBodies";
import { SpreadsLibraryRoot } from "../../../islands/SpreadIslands";
import { SiteFooterRoot, SiteHeaderRoot } from "../../../islands/SiteShell";

/** 📐 คลังผังพยากรณ์ 25 แบบ — หน้ารวม (ต้นไม้ภาษาอังกฤษ) */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={buildSpreadsIndexMetadata(locale)}>
  <SiteHeaderRoot locale={locale} />
  <SpreadsIndexBodyRoot locale={locale}>
    <Fragment slot="library">
      <SpreadsLibraryRoot locale={locale} />
    </Fragment>
  </SpreadsIndexBodyRoot>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!--
  🗂️ แท็บหมวดของคลังผัง — สคริปต์ ~1 KB แทนการ hydrate คลังทั้งก้อน (R-02)
  การ์ดทั้ง 25 ใบอยู่ใน HTML แล้ว สคริปต์แค่สลับ `hidden` เท่านั้น
-->
<script>
  import "../../../scripts/spreads-tabs";
</script>
