---
import { spreadBuilderMetadataEn } from "@/app/_shared/pages/spread-builder-meta";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SpreadBuilderRoot } from "../../../islands/SpreadBuilderRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";
import "@/styles/v2-spread-builder.css";

/**
 * ✦ ห้องออกแบบผัง (REFLECTION_JOURNAL_PLAN 1.8 · คลื่น 5) — เชลล์ static + island เดียว · noindex
 * อยู่ใต้ prefix `/spreads` ของ Astro แล้ว (src/lib/routing/astro-routes.ts) — หน้า static ชนะ `[id].astro` เสมอ
 * ลิงก์แบ่งปัน = `?s=<slug>` (หน้า static ทำเส้นทางไดนามิกไม่ได้ · island อ่านเองหลัง hydrate)
 */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={spreadBuilderMetadataEn}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <SpreadBuilderRoot locale={locale} client:load />
  </div>
  <SiteFooterRoot locale={locale} spacing="tight" />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../../scripts/ui2-inview";
</script>
