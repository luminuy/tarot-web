---
import { privacyMetadataEn } from "@/app/_shared/pages/privacy-en";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { PrivacyBodyEnRoot } from "../../components/PageBodies";
import { DeleteAllDataRoot } from "../../islands/DeleteAllDataRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";

/**
 * 🔐 นโยบายความเป็นส่วนตัว (อังกฤษ) — หน้านี้ **ไม่โหลด React เลยสักไบต์** (2026-09-18)
 * เหตุผลและกับดักเหมือนฝั่งไทยทุกข้อ ดู `astro/pages/privacy.astro`
 */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={privacyMetadataEn}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <PrivacyBodyEnRoot>
    <Fragment slot="deleteButton">
      <DeleteAllDataRoot locale={locale} />
    </Fragment>
  </PrivacyBodyEnRoot>
  <SiteFooterRoot locale={locale} spacing="tight" />
  <script>
    import "../../scripts/delete-all-data";
  </script>
</BaseLayout>
