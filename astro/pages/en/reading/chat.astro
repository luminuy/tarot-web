---
import { readingChatMetadataEn } from "@/app/_shared/pages/reading-chat-en";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ReadingChatRootEn } from "../../../islands/ReadingChatRoot";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";

/**
 * 💬 ห้องสนทนากับแม่หมอ (ต้นไม้ภาษาอังกฤษ)
 * ⚠️ หน้านี้ไม่มี SiteHeader/SiteFooter โดยตั้งใจ — มีแถบหัวของตัวเอง (`data-site-header="reading-chat"`)
 *    เหมือนตอนอยู่กับ Next เป๊ะ · ห้ามเติมเข้ามา ไม่งั้นจะได้หัวเว็บซ้อนสองชั้น
 */
const locale = "en" as const;
---

<BaseLayout hasSiteHeader={false} locale={locale} metadata={readingChatMetadataEn}>
  <div class="ui2-pg" data-ui2-page-dark="">
  <ReadingChatRootEn client:load />
  </div>
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../../scripts/ui2-inview";
</script>
