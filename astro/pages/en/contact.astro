---
import { contactMetadataEn } from "@/app/_shared/pages/contact-en";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { ContactBodyEnRoot } from "../../components/PageBodies";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";

/** ✉️ ช่องทางติดต่อ — หน้าข้อความล้วน ไม่มีส่วนไหนต้องใช้ JS เลย */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={contactMetadataEn}>
  <SiteHeaderRoot locale={locale} />
  <ContactBodyEnRoot />
  <SiteFooterRoot locale={locale} spacing="tight" />
</BaseLayout>
