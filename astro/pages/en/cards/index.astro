---
import { buildCardsIndexMetadata } from "@/app/_shared/pages/cards-index";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { CardsIndexBodyRoot } from "../../../components/PageBodies";
import { CardsExplorerRoot } from "../../../islands/CardsExplorerRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";
import "@/styles/v2-cards.css";

/** 🃏 สารานุกรมไพ่ 78 ใบ — หน้ารวม (ต้นไม้ภาษาอังกฤษ) */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={buildCardsIndexMetadata(locale)}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <CardsIndexBodyRoot locale={locale}>
    <Fragment slot="explorer">
      <CardsExplorerRoot locale={locale} client:idle />
    </Fragment>
  </CardsIndexBodyRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../../scripts/ui2-inview";
</script>
