---
import { zodiacIndexMetadata, ZODIAC_FINDER_ITEMS } from "@/app/_shared/pages/zodiac";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ZodiacIndexBodyRoot } from "../../../components/PageBodies";
import { ZodiacCompatibilityRoot, ZodiacFinderRoot } from "../../../islands/ZodiacFinderRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../../../islands/SiteShell";

/** ✦ ไพ่ประจำราศี 12 ราศี — หน้ารวม + เครื่องหาราศีจากวันเกิด (ต้นไม้ภาษาอังกฤษ) */
const locale = "en" as const;
---

<BaseLayout locale={locale} metadata={zodiacIndexMetadata(locale)}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <ZodiacIndexBodyRoot locale={locale}>
    <Fragment slot="finder">
      <ZodiacFinderRoot signs={ZODIAC_FINDER_ITEMS} locale={locale} client:idle />
    </Fragment>
    <Fragment slot="compat">
      <ZodiacCompatibilityRoot signs={ZODIAC_FINDER_ITEMS} locale={locale} client:visible />
    </Fragment>
  </ZodiacIndexBodyRoot>
  <SiteFooterRoot locale={locale} />
</BaseLayout>
