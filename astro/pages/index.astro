---
import { buildHomeMetadata, homeJsonLdBlocks } from "@/app/_shared/pages/home";
import { readSpreadStaticParams } from "@/app/_shared/pages/read-spread";

import BaseLayout from "../layouts/BaseLayout.astro";
import { HomeSeoRoot } from "../components/HomeSeoRoot";
import { TarotFlowRoot } from "../islands/TarotFlowRoot";

/**
 * 🏠 หน้าแรก (ต้นไม้ภาษาไทย)
 *
 * ⚠️ ห้ามใส่ `SiteHeaderRoot` / `SiteFooterRoot` ที่นี่ — `TarotFlow` เรนเดอร์ทั้งสองอย่าง
 *    ของตัวเองอยู่ข้างในแล้ว (เหมือนตอนอยู่กับ Next เป๊ะ) ถ้าเติมจะได้หัวเว็บซ้อนสองชั้น
 */
const locale = "th" as const;
/**
 * ↪️ ลิงก์เก่า `/?spread=<ผัง>` ➔ หน้าดูดวงรายผัง `/read/<ผัง>` (2026-09-23)
 *
 * ปุ่มทุกปุ่มในเว็บชี้ `/read/<ผัง>` แล้ว แต่ลิงก์แบบเก่ายังค้างอยู่ในบุ๊กมาร์ก · ลิงก์ที่แชร์ไปแล้ว
 * และแคชของ service worker · เด้งต่อด้วยสคริปต์บรรทัดเดียวก่อนหน้าแรกจะวาด (ผู้ใช้ไม่เห็นหน้าแรก)
 * ใช้ `replace` ไม่ใช่ `assign` — กดย้อนกลับแล้วต้องไม่วนมาเจอลิงก์เก่าที่เด้งซ้ำไม่จบ
 * ผังที่ไม่มีอยู่จริง = ไม่ใช่คำสั่ง อยู่หน้าแรกตามเดิม
 */
const readSpreadIds = readSpreadStaticParams().map(({ id }) => id);
const readPrefix = "/read/";
---

<BaseLayout locale={locale} metadata={buildHomeMetadata(locale)}>
  {/* สมาชิก (มีคุกกี้ใบ้ `tarot_has_session`) ➔ คลาส has-session บน <html> ก่อนเฟรมแรก ให้ `.home-welcome-slot`
      จองที่ไว้ตั้งแต่ HTML แรก (CLS 0) · คุกกี้ใบ้ไม่ใช่ตัวตัดสินสิทธิ์ ใช้แค่กะที่ว่าง (ดู session-hint.ts) */}
  <script is:inline>
    try {
      if (document.cookie.split("; ").some(function (c) { return c.indexOf("tarot_has_session=1") === 0; }))
        document.documentElement.classList.add("has-session");
    } catch (e) {}
  </script>
  <script is:inline define:vars={{ readSpreadIds, readPrefix }}>
    try {
      var legacySpread = new URLSearchParams(location.search).get("spread");
      if (legacySpread && readSpreadIds.indexOf(legacySpread) !== -1) location.replace(readPrefix + legacySpread);
    } catch (e) {}
  </script>
  {homeJsonLdBlocks(locale).map((block) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
  ))}
  <TarotFlowRoot locale={locale} client:load>
    <Fragment slot="seoContent">
      <HomeSeoRoot locale={locale} />
    </Fragment>
  </TarotFlowRoot>
  {/* ลูกศรของสไลด์การ์ดในเนื้อหาท้ายหน้า (HTML นิ่ง) — ดู astro/scripts/home-rails.ts
      นับการเห็น/กดแต่ละส่วน + ตัวนับคำทำนาย — ดู astro/scripts/home-track.ts */}
  <script>
    import "../scripts/home-rails";
    import "../scripts/home-track";
  </script>
</BaseLayout>
