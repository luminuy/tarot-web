---
import {
  spreadDetailMetadata,
  spreadDetailProps,
  spreadStaticParams,
} from "@/app/_shared/pages/spread-detail";
import { getSpread } from "@/data/spreads";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SpreadDetailContentRoot } from "../../components/PageBodies";
import { SpreadDetailRoot } from "../../islands/SpreadIslands";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";
/* ไพ่ผังกลางแบบคลังผัง /spreads + หน้าต่างไพ่เด้ง (เจ้าของ 2026-10-26) — ไฟล์เล็กแยก · นำเข้าก่อนสไตล์ของหน้า (หน้านี้ปรับไพ่ใบใหญ่ทับได้) */
import "@/styles/ui2-spread-card.css";
import "@/styles/ui2-spread-card-fx.css";
import "@/styles/v2-spread-detail.css";

/** 📐 คู่มือผังพยากรณ์รายผัง 26 หน้า (ต้นไม้ภาษาไทย) */
const locale = "th" as const;

export function getStaticPaths() {
  return spreadStaticParams().map(({ id }) => ({ params: { id } }));
}

const spread = getSpread(Astro.params.id!)!;
const detailProps = spreadDetailProps(spread, locale);
---

<BaseLayout locale={locale} metadata={spreadDetailMetadata(spread.id, locale)}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <SpreadDetailContentRoot spread={spread} locale={locale}>
    <Fragment slot="detail">
      <SpreadDetailRoot {...detailProps} locale={locale} />
    </Fragment>
  </SpreadDetailContentRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ · กระดานตำแหน่ง · ไพ่ผังอื่นเด้ง + นับการแตะ -->
<script>
  import "../../scripts/ui2-inview";
  import "../../scripts/spread-board";
  import { initSpreadPop } from "../../scripts/spread-pop";
  initSpreadPop();
</script>
