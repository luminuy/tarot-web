---
import { birthCardMetadataTh, MAJOR_CARDS } from "@/app/_shared/pages/birth-card-th";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { BirthCardBodyThRoot } from "../../components/PageBodies";
import { BirthCardCalculatorRoot } from "../../islands/BirthCardCalculatorRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";

/** 🎂 คำนวณไพ่ทาโรต์ประจำตัวจากวันเกิด (ต้นไม้ภาษาไทย) */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={birthCardMetadataTh}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <BirthCardBodyThRoot>
    <Fragment slot="calculator">
      <BirthCardCalculatorRoot majorCards={MAJOR_CARDS} locale={locale} client:idle />
    </Fragment>
  </BirthCardBodyThRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../scripts/ui2-inview";
</script>
