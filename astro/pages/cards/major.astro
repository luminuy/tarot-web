---
import { buildCardGroupMetadata } from "@/app/_shared/pages/card-group";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { CardGroupBodyRoot } from "../../components/PageBodies";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";
import "@/styles/ui2-showcase.css";
import "@/styles/v3-card-tile.css";
import "@/styles/v2-card-group.css";

/** 🃏 หน้าหมวดหมู่ไพ่ `major` (ต้นไม้ภาษาไทย) — ไม่มีส่วนที่ต้องใช้ JS เลย */
const locale = "th" as const;
const groupId = "major" as const;
---

<BaseLayout locale={locale} metadata={buildCardGroupMetadata(groupId, locale)}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <CardGroupBodyRoot groupId={groupId} locale={locale} />
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../scripts/ui2-inview";
  import "../../scripts/ui2-showcase";
</script>
