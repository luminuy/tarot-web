---
import { privacyMetadataTh } from "@/app/_shared/pages/privacy-th";

import BaseLayout from "../layouts/BaseLayout.astro";
import { PrivacyBodyThRoot } from "../components/PageBodies";
import { DeleteAllDataRoot } from "../islands/DeleteAllDataRoot";
import { SiteFooterRoot, SiteHeaderRoot } from "../islands/SiteShell";

/**
 * 🔐 นโยบายความเป็นส่วนตัว — หน้านี้ **ไม่โหลด React เลยสักไบต์** (2026-09-18)
 *
 * ปุ่มลบข้อมูล PDPA เคยเป็น island เดียวของหน้าที่ `client:idle` แลกกับ React 184 KB
 * ตอนนี้เรนเดอร์เป็น HTML ล้วนจากคอมโพเนนต์ตัวเดิม แล้วให้สคริปต์ข้างล่างผูกพฤติกรรมให้
 *
 * ⚠️ ถ้าวันหนึ่งต้องใส่ `client:*` กลับเข้าไป ต้องถอด `import` ของสคริปต์ออกด้วย
 *    ไม่งั้นปุ่มจะมีตัวจัดการสองตัว = ถามยืนยันการลบสองรอบ
 */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={privacyMetadataTh}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <PrivacyBodyThRoot>
    <Fragment slot="deleteButton">
      <DeleteAllDataRoot locale={locale} />
    </Fragment>
  </PrivacyBodyThRoot>
  <SiteFooterRoot locale={locale} spacing="tight" />
  <script>
    import "../scripts/delete-all-data";
  </script>
</BaseLayout>
