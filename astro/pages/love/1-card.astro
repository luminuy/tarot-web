---
import { loveOneCardMetadataTh } from "@/app/_shared/pages/love-one-card-th";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { LoveOneCardBodyThRoot } from "../../components/PageBodies";
import { LoveOneCardRitualRoot } from "../../islands/RitualRoots";
import { SiteFooterRoot, SiteHeaderRoot } from "../../islands/SiteShell";
import "@/styles/ui2-page.css";
import "@/styles/ui2-page-fx.css";

/** 💗 ไพ่ความรักใบเดียว — พิธีเปิดไพ่เป็น island · เนื้อหา SEO ท้ายหน้าเป็น HTML ล้วน */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={loveOneCardMetadataTh}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <div class="ui2-pg" data-ui2-page-dark="">
  <LoveOneCardBodyThRoot>
    <Fragment slot="ritual">
      <LoveOneCardRitualRoot locale={locale} client:load />
    </Fragment>
  </LoveOneCardBodyThRoot>
  </div>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ไพ่ลอยหัวหน้า UI 2.0) เมื่อพ้นจอ -->
<script>
  import "../../scripts/ui2-inview";
</script>
