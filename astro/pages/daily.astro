---
import { dailyMetadataTh } from "@/app/_shared/pages/daily-th";

import BaseLayout from "../layouts/BaseLayout.astro";
import { DailyBodyThRoot } from "../components/PageBodies";
import { DailyRitualRoot } from "../islands/RitualRoots";
import "@/styles/ui2-daily.css";
import "@/styles/ui2-daily-fx.css";
import { SiteFooterRoot, SiteHeaderRoot } from "../islands/SiteShell";

/** 🌅 ไพ่ประจำวัน — พิธีเปิดไพ่เป็น island · เนื้อหา SEO ท้ายหน้าเป็น HTML ล้วน */
const locale = "th" as const;
---

<BaseLayout locale={locale} metadata={dailyMetadataTh}>
  <SiteHeaderRoot locale={locale} pathname={Astro.url.pathname} />
  <DailyBodyThRoot>
    <Fragment slot="ritual">
      <DailyRitualRoot locale={locale} client:load />
    </Fragment>
  </DailyBodyThRoot>
  <SiteFooterRoot locale={locale} />
</BaseLayout>

<!-- หยุดของวน (ดาว · ไพ่ลอย) เมื่อส่วนพ้นจอ — สคริปต์ธรรมดา ไม่ลาก React -->
<script>
  import "../scripts/ui2-inview";
</script>
